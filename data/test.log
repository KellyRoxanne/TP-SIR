/*C10*/SET SCHEMA PUBLIC
\u000a    drop table if exists Administrateur cascade 
\u000a    drop table if exists Client cascade 
\u000a    drop table if exists Concert cascade 
\u000a    drop table if exists Lieu cascade 
\u000a    drop table if exists Organisateur cascade 
\u000a    drop table if exists Ticket cascade 
\u000a    drop table if exists Utilisateur cascade 
\u000a    drop sequence Concert_SEQ if exists
\u000a    drop sequence Lieu_SEQ if exists
\u000a    drop sequence Ticket_SEQ if exists
\u000a    drop sequence Utilisateur_SEQ if exists
\u000a    create sequence Concert_SEQ start with 1 increment by 50
\u000a    create sequence Lieu_SEQ start with 1 increment by 50
\u000a    create sequence Ticket_SEQ start with 1 increment by 50
\u000a    create sequence Utilisateur_SEQ start with 1 increment by 50
\u000a    create table Administrateur (\u000a        niveau integer not null,\u000a        id bigint not null,\u000a        primary key (id)\u000a    )
\u000a    create table Client (\u000a        id bigint not null,\u000a        primary key (id)\u000a    )
\u000a    create table Concert (\u000a        price float(53) not null,\u000a        id bigint not null,\u000a        location varchar(255),\u000a        title varchar(255),\u000a        primary key (id)\u000a    )
\u000a    create table Lieu (\u000a        capacite integer not null,\u000a        id bigint not null,\u000a        adresse varchar(255),\u000a        nom varchar(255),\u000a        pays varchar(255),\u000a        ville varchar(255),\u000a        primary key (id)\u000a    )
\u000a    create table Organisateur (\u000a        id bigint not null,\u000a        nomEntreprise varchar(255),\u000a        siret varchar(255),\u000a        primary key (id)\u000a    )
\u000a    create table Ticket (\u000a        price float(53) not null,\u000a        concert_id bigint,\u000a        id bigint not null,\u000a        type varchar(255),\u000a        primary key (id)\u000a    )
\u000a    create table Utilisateur (\u000a        dateInscription timestamp(6),\u000a        id bigint not null,\u000a        email varchar(255),\u000a        motDePasse varchar(255),\u000a        nom varchar(255),\u000a        prenom varchar(255),\u000a        telephone varchar(255),\u000a        primary key (id)\u000a    )
\u000a    alter table Administrateur \u000a       add constraint FKdmj1rsd0ke7e076tdtmx86pfc \u000a       foreign key (id) \u000a       references Utilisateur
\u000a    alter table Client \u000a       add constraint FK31jffco39wivno1u5a6flswnt \u000a       foreign key (id) \u000a       references Utilisateur
\u000a    alter table Organisateur \u000a       add constraint FKj67cirdy2sicj46b6l71fleou \u000a       foreign key (id) \u000a       references Utilisateur
\u000a    alter table Ticket \u000a       add constraint FKin9kj2wiejns9ptuw1pt351kg \u000a       foreign key (concert_id) \u000a       references Concert
